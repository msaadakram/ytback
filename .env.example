# Server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# CORS (comma-separated list; * allows all)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Directories (relative to project root)
DOWNLOAD_DIR=downloads
TEMP_DIR=temp

# Limits
MAX_FILE_SIZE=10737418240
MAX_DOWNLOAD_TIME=1800
MAX_CONCURRENT_DOWNLOADS=3

# Job lifecycle
AUTO_DELETE_MINUTES=60

# External binaries (leave default to use PATH)
YTDLP_BIN=yt-dlp
FFMPEG_BIN=ffmpeg

# Authentication (optional)
# COOKIES_FILE=cookies.txt
# COOKIES_FROM_BROWSER=firefox
# YOUTUBE_COOKIES — base64-encoded Netscape cookies.txt, materialized to disk at
# boot. Recommended on Heroku to keep login cookies out of git. Set with:
#   heroku config:set YOUTUBE_COOKIES="$(base64 -w0 cookies.txt)" -a <app>
# YOUTUBE_COOKIES=

# MongoDB connection
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
# MONGODB_DB=downforge

# User sessions (default 30 days)
# USER_SESSION_TTL_HOURS=720

# App base URL (for Stripe success/cancel redirects and auth email links)
# APP_BASE_URL=http://localhost:3000

# Resend (https://resend.com) — transactional email for verification & password
# reset codes. Optional: codes are logged to the server output when unset, so
# development works without a mail provider.
# 1. Create an API key at https://dashboard.resend.com/api-keys
# 2. Verify your sending domain at https://dashboard.resend.com/domains
#    (Resend handles the DNS records: SPF, DKIM, DMARC — sending & receiving).
# 3. Set RESEND_FROM to any address on the verified domain.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="DownForge <no-reply@downforge.me>"

# Verification / reset code lifetimes
# EMAIL_CODE_TTL_MINUTES=10
# EMAIL_CODE_RESEND_SECONDS=60
# EMAIL_CODE_MAX_ATTEMPTS=6
# PASSWORD_RESET_TTL_MINUTES=15

# Groq API key for Whisper transcription (optional)
# GROQ_API_KEY=

# Stripe (optional — billing degrades gracefully when unset)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRO_PRICE_ID=

